{
  "name": "godhand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GODHAND — a hand-tracked real-time war game. Pinch your castles, fling your armies, smite your enemies.",
  "scripts": {
    "dev": "vite --host",
